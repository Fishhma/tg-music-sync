# my.telegram.org -> API development tools (ОТДЕЛЬНЫЙ аккаунтом)
API_ID=
API_HASH=

# Токен бота от @BotFather
BOT_TOKEN=

# id в Telegram (кому бот пишет).
# запустите, напишите боту /start — он пришлёт id.
OWNER_ID=

# Каналы через запятую: username, ссылка t.me/... или id вида -1001234567890
# Аккаунт должен быть на них подписан.
CHANNELS=channel_one,channel_two

# Когда делать ежемесячную проверку: число месяца (1-28) и час
SCAN_DAY=1
SCAN_HOUR=10
TZ=Europe/Moscow

# Папка музыки на хосте (та же, что смонтирована в Navidrome)
MUSIC_PATH=/path/to/navidrome/music
# Внутри контейнера треки попадут в /music/telegram/<Название канала>/
MUSIC_DIR=/music/telegram

# Дописывать пустые теги (title/artist/album) из данных Telegram
FIX_TAGS=true

# uid/gid владельца папки с музыкой (команда id на хосте)
PUID=1000
PGID=1000
